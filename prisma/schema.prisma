generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  passwordHash        String
  name                String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  operatorStatus      String         @default("none")
  operatorRole        String?
  operatorRequestedAt DateTime?
  operatorGrantedAt   DateTime?
  conversations       Conversation[]
  serviceTasks        ServiceTask[]
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model ServiceTask {
  id          String         @id @default(cuid())
  userId      String
  serviceId   String
  title       String
  status      String         @default("AWAITING_PAYMENT")
  detailsJson String         @default("{}")
  resultJson  String?
  amountKobo  Int            @default(0)
  currency    String         @default("NGN")
  paymentRef  String?        @unique
  paidAt      DateTime?
  attempts    Int            @default(0)
  maxAttempts Int            @default(3)
  runAfter    DateTime       @default(now())
  lockedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   TaskDocument[]
  events      TaskEvent[]

  @@index([userId, createdAt])
  @@index([status, runAfter])
}

model TaskDocument {
  id          String      @id @default(cuid())
  taskId      String
  kind        String
  label       String
  filename    String
  mimeType    String
  data        Bytes?
  fileUrl     String?
  storagePath String?
  createdAt   DateTime    @default(now())
  task        ServiceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskEvent {
  id        String      @id @default(cuid())
  taskId    String
  type      String
  message   String
  dataJson  String?
  createdAt DateTime    @default(now())
  task      ServiceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}
